
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "price_vnd"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "isbn": {
      "type": ["string", "null"],
      "pattern": "^\\d{13}$"
    },
    "price_vnd": {
      "type": "integer",
      "minimum": 0
    },
    "stock": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "category_id": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "author_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true,
      "default": []
    }
  },
  "additionalProperties": false
}
