
{
  "info": {
    "name": "Books API - Lab 08",
    "description": "Lab 3 - Newman runnable collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "books",
      "item": [
        {
          "name": "GET /books",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/books"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Body is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
              ]
            }
          }]
        },
        {
          "name": "POST /books - create",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"DDIA\",\"author\":\"Kleppmann\",\"year\":2017}"
            },
            "url": "{{base_url}}/books"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.test('Created book has valid id', () => pm.expect(pm.response.json().id).to.be.above(0));",
                "if (pm.response.code === 201) pm.collectionVariables.set('book_id', pm.response.json().id);"
              ]
            }
          }]
        },
        {
          "name": "GET /books/{id}",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/books/{{book_id}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Book has required fields', () => pm.expect(pm.response.json()).to.have.all.keys('id','title','author','year','isbn'));"
              ]
            }
          }]
        },
        {
          "name": "PUT /books/{id}",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"DDIA revised\",\"author\":\"Kleppmann\",\"year\":2017}"
            },
            "url": "{{base_url}}/books/{{book_id}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Title updated', () => pm.expect(pm.response.json().title).to.eql('DDIA revised'));"
              ]
            }
          }]
        },
        {
          "name": "DELETE /books/{id}",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/books/{{book_id}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 204', () => pm.response.to.have.status(204));",
                "pm.test('Response body is empty', () => pm.expect(pm.response.text()).to.eql(''));"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "error-cases",
      "item": [
        {
          "name": "POST /books - missing title",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"author\":\"Kleppmann\",\"year\":2017}"
            },
            "url": "{{base_url}}/books"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 400', () => pm.response.to.have.status(400));",
                "pm.test('Validation error identifies title', () => { const b = pm.response.json(); pm.expect(b.code).to.eql('VALIDATION_ERROR'); pm.expect(b.errors.some(e => e.field === 'title')).to.eql(true); });"
              ]
            }
          }]
        },
        {
          "name": "GET /books/9999 - not found",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/books/9999"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 404', () => pm.response.to.have.status(404));",
                "pm.test('Not found error body', () => { const b = pm.response.json(); pm.expect(b.code).to.eql('NOT_FOUND'); pm.expect(b.message).to.eql('Book not found'); });"
              ]
            }
          }]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "book_id",
      "value": ""
    }
  ]
}
